digraph schema { graph [bgcolor="white",pad="0.4",nodesep="0.7",ranksep="0.8",dpi=150]; node [shape=plain,fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=11,color="#374151"]; med [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#374151"><TR><TD COLSPAN="3" BGCOLOR="#274e87"><FONT COLOR="white" POINT-SIZE="22"><B>treatment_medications</B></FONT></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">varchar(255) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">older_adult_id</TD><TD ALIGN="LEFT">varchar(36) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(160) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">presentation</TD><TD ALIGN="LEFT">varchar(160) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">boolean NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz NOT NULL</TD></TR></TABLE>>];treatment [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#374151"><TR><TD COLSPAN="3" BGCOLOR="#274e87"><FONT COLOR="white" POINT-SIZE="22"><B>treatment_treatments</B></FONT></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">varchar(255) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">older_adult_id</TD><TD ALIGN="LEFT">varchar(36) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">medication_id</TD><TD ALIGN="LEFT">varchar(36) NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(160) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(30) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">dose / frequency</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">instructions</TD><TD ALIGN="LEFT">varchar(500) NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">reminder_lead_minutes</TD><TD ALIGN="LEFT">integer NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz NOT NULL</TD></TR></TABLE>>];times [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#374151"><TR><TD COLSPAN="3" BGCOLOR="#274e87"><FONT COLOR="white" POINT-SIZE="22"><B>treatment_schedule_times</B></FONT></TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT">treatment_id</TD><TD ALIGN="LEFT">varchar(255) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">schedule_order</TD><TD ALIGN="LEFT">integer NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">scheduled_time</TD><TD ALIGN="LEFT">time NOT NULL</TD></TR></TABLE>>];med -> treatment [style=dashed,label="medicationId: logical reference",constraint=false]; treatment -> times [label="1 to N: same BC"]; {rank=same;med;treatment;} }