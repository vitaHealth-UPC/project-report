digraph schema { graph [bgcolor="white",pad="0.4",nodesep="0.7",ranksep="0.8",dpi=150]; node [shape=plain,fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=11,color="#374151"]; intake [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#374151"><TR><TD COLSPAN="3" BGCOLOR="#274e87"><FONT COLOR="white" POINT-SIZE="22"><B>intake_intakes</B></FONT></TD></TR><TR><TD>PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">varchar(36) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">treatment_id</TD><TD ALIGN="LEFT">varchar(36) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">medication_id</TD><TD ALIGN="LEFT">varchar(36) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">older_adult_id</TD><TD ALIGN="LEFT">varchar(36) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">medication_name</TD><TD ALIGN="LEFT">varchar(160) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">dose</TD><TD ALIGN="LEFT">varchar(100) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">instructions</TD><TD ALIGN="LEFT">varchar(500) NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">scheduled_at</TD><TD ALIGN="LEFT">timestamptz NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(24) NOT NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">confirmed_at</TD><TD ALIGN="LEFT">timestamptz NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">confirmation_channel</TD><TD ALIGN="LEFT">varchar(16) NULL</TD></TR><TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz NOT NULL</TD></TR></TABLE>>]; }